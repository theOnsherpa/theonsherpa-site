---
import IntakeForm from "../components/IntakeForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact | The Onsherpa"
  description="Book a free consultation with Evan Reese about Onshape consulting, migration, or custom FeatureScript."
>
  <section class="contact-layout">
    <div class="contact-copy">
      <p class="eyebrow">Contact</p>
      <h1>Tell me what is slowing your team down.</h1>
      <p>
        Share a little context about your Onshape setup, the friction you are
        seeing, and what kind of help would be useful.
      </p>
      <p>
        <em>
          This form is for business inquiries, and other topics may not get a reply.
          <br />
          If you have an Onshape question, please ask it on the public
          <a href="https://forum.onshape.com/">Onshape Forum</a> and tag @EvanReese
          in the message body.
        </em>
      </p>
    </div>
    <IntakeForm />
  </section>
</BaseLayout>

<style>
  .contact-copy a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
