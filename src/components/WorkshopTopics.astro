---
import { workshopTopics } from "../data/workshops";
---

<div class="workshop-topics">
  <h3>Workshop topics</h3>
  <p>Choose one topic for both sessions. Expand a topic to learn more.</p>
  {workshopTopics.map((topic) => (
    <details>
      <summary>{topic.title}</summary>
      <div class="topic-content">
        {topic.quote && (
          <figure class="topic-quote">
            <blockquote><p>&ldquo;{topic.quote.text}&rdquo;</p></blockquote>
            <figcaption>{topic.quote.attribution}</figcaption>
          </figure>
        )}
        <p>{topic.description}</p>
        {topic.video && (
          <video data-workshop-loop muted playsinline loop preload="none" poster={topic.video.poster} aria-label={topic.video.label}>
            <source src={topic.video.src} type="video/mp4" />
            <a href={topic.video.src}>Watch the branching and merging demonstration</a>
          </video>
        )}
        {topic.images.length > 0 && (
          <div class:list={["topic-images", { "topic-images-strip": topic.gallery === "strip" }]} tabindex={topic.gallery === "strip" ? 0 : undefined} role={topic.gallery === "strip" ? "region" : undefined} aria-label={topic.gallery === "strip" ? `${topic.title} example gallery, scroll horizontally for more` : undefined}>
            {topic.images.map((image) => (
              <figure>
                <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
                {image.caption && <figcaption>{image.caption}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </div>
    </details>
  ))}
</div>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  document.querySelectorAll<HTMLVideoElement>("video[data-workshop-loop]").forEach((video) => {
    const details = video.closest("details");
    let visible = false;
    video.muted = true;

    // Start only when visible, rather than letting autoplay load collapsed demos.
    const syncPlayback = () => {
      if (visible && details?.open && !document.hidden && !reducedMotion.matches) {
        void video.play().catch(() => { /* Keep the poster if autoplay is blocked. */ });
      } else {
        video.pause();
      }
    };
    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      syncPlayback();
    });
    observer.observe(video);
    details?.addEventListener("toggle", syncPlayback);
    reducedMotion.addEventListener("change", syncPlayback);
    document.addEventListener("visibilitychange", syncPlayback);
  });
</script>

<style>
  .workshop-topics { grid-column: 1 / -1; min-width: 0; }
  video { display: block; width: min(100%, 846px); height: auto; margin-top: 1.5rem; border-radius: 6px; }
  details { border-bottom: 1px solid var(--line); }
  details:first-of-type { border-top: 1px solid var(--line); }
  summary {
    padding: 1.25rem 0.5rem;
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(1rem, 1.7vw, 1.25rem);
  }
  summary::marker { color: var(--brand-green-dark); }
  summary:hover { background: rgba(96, 152, 101, 0.08); }
  summary:focus-visible { outline: 2px solid var(--brand-green-dark); outline-offset: 3px; }
  .topic-content { padding: 0 0.5rem 1.5rem; }
  .topic-content > p { max-width: 75ch; margin: 0; }
  .topic-images { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; margin-top: 1.5rem; }
  figure { margin: 0; }
  figure:only-child { grid-column: 1 / -1; width: min(100%, 846px); }
  img { display: block; width: 100%; height: auto; border-radius: 6px; }
  figcaption { margin-top: 0.5rem; font-size: 0.95rem; }
  .topic-quote {
    border-left: 3px solid var(--brand-green);
    padding: 0.4rem 0 0.4rem 1.25rem;
    margin: 0 0 1.5rem;
    max-width: 65ch;
  }
  .topic-quote blockquote { margin: 0; }
  .topic-quote p { font-size: clamp(1.15rem, 2vw, 1.5rem); font-style: italic; margin: 0; }
  .topic-quote figcaption { font-family: var(--font-sans); color: #657168; font-size: 0.75rem; font-weight: 400; line-height: 1.5; margin-top: 0.4rem; }
  @media (max-width: 620px) { .topic-images { grid-template-columns: 1fr; } }
  .topic-images-strip {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 1rem;
    scroll-snap-type: x proximity;
  }
  .topic-images-strip figure { flex: 0 0 auto; scroll-snap-align: start; }
  .topic-images-strip img { width: auto; height: clamp(180px, 22vw, 270px); max-width: none; }
  .topic-images-strip:focus-visible { outline: 2px solid var(--brand-green-dark); outline-offset: 4px; }
</style>
